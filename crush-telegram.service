[Unit]
Description=crush-Telegram bridge — Telegram <-> Crush CLI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/crush-telegram
ExecStart=/root/.bun/bin/bun run /opt/crush-telegram/src/index.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
