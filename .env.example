# crush-Telegram bridge configuration — copy to .env and edit

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your numeric Telegram user id from @userinfobot (required)
# Only this user can drive the bot. Everyone else is ignored.
OWNER_ID=123456789

# Dashboard HTTP port (optional — leave blank to disable)
DASH_PORT=8088

# Dashboard access key (?key=...) — set a long random string
DASH_KEY=change-me-to-a-long-random-string

# Crush working directory (where headless turns run)
CRUSH_CWD=/root

# Run crush with --yolo (auto-accept permissions). Default: false.
CRUSH_YOLO=false

# Max seconds for a single crush turn before it is killed
CRUSH_TIMEOUT=600

# Optional: pin a model (e.g. "gpt-5-codex"). Leave blank for default.
# CRUSH_MODEL=
