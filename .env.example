# crush-Telegram bridge configuration — copy to .env and edit

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your numeric Telegram user id from @userinfobot (required)
# Only this user can drive the bot. Everyone else is ignored.
OWNER_ID=123456789

# Crush server TCP port (the bridge starts crush server automatically)
CRUSH_SERVER_PORT=23917

# Crush working directory (shares this dir's ~/.crush sessions with terminal)
CRUSH_CWD=/root

# Auto-allow all tool permissions. Set false for interactive Allow/Deny buttons.
CRUSH_AUTO_ALLOW=true

# Max seconds for a single crush turn before it is killed
CRUSH_TIMEOUT=600

# Dashboard HTTP port (optional — leave blank to disable)
DASH_PORT=8088

# Dashboard access key (?key=...) — set a long random string
DASH_KEY=change-me-to-a-long-random-string

# Optional: pin a model (e.g. "zai/glm-4.6"). Leave blank for default.
# CRUSH_MODEL=
